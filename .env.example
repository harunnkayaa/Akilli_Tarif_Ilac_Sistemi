# Bu dosyayı .env olarak kopyalayın:  cp .env.example .env
# docker compose bu değerleri otomatik okur.

# ---- OpenAI (chat / tarif önerisi için ZORUNLU) ----
# Yoksa uygulama açılır ama chat cevap veremez.
OPENAI_API_KEY=
USE_RECIPE_LLM=1
OPENAI_CHAT_MODEL=gpt-4o-mini

# ---- API adresi ----
# Tarif görsellerinin URL'i buradan üretilir.
# Aynı bilgisayarda test:            http://localhost:8000
# Telefondan aynı ağ üzerinden:      http://<bilgisayarin-yerel-IP>:8000
# Yayına alındıysa:                  https://<sunucu-adresi>
BASE_URL=http://localhost:8000

# ---- Güvenlik ----
# Teslim öncesi rastgele bir değerle değiştirin.
SECRET_KEY=lutfen-bunu-degistirin
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# ---- Veritabanı (docker compose kendi içinde kullanır) ----
DB_USER=appuser
DB_PASSWORD=apppass
DB_NAME=smartapp

# ---- Portlar ----
# 8000 doluysa değiştirin (ör. 8080). APK'daki adresle uyumlu olmalı.
API_PORT=8000
