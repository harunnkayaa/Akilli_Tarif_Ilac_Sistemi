cat > .gitignore << 'EOF'
build/
.pub-cache/
.flutter-plugins
.flutter-plugins-dependencies
.packages

# --- Android / iOS generated ---
android/.gradle/
android/local.properties
ios/Pods/
ios/.symlinks/
ios/Flutter/Flutter.framework
ios/Flutter/Flutter.podspec
ios/Flutter/Flutter.xcframework

# --- IDE ---
.vscode/
.idea/
*.iml

# --- Logs ---
*.log
EOF
